{
  "name": "rxplus",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run --project unit",
    "preview": "node dist/analog/server/index.mjs",
    "test:watch": "vitest --project unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:int": "vitest run --project integration",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --wait db",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "hash-password": "node scripts/hash-password.ts",
    "e2e": "npm run build && playwright test",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node24 --format=cjs --external:pg-native --outfile=dist/migrate.cjs"
  },
  "private": true,
  "dependencies": {
    "@analogjs/router": "2.7.5",
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@ngrx/effects": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@primeuix/themes": "3.0.1",
    "@tailwindcss/vite": "4.3.3",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "primeng": "22.1.1",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "tslib": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@analogjs/platform": "2.7.5",
    "@analogjs/vite-plugin-angular": "2.7.5",
    "@analogjs/vitest-angular": "2.7.5",
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "angular-eslint": "22.5.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.27.7",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "22.1.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
