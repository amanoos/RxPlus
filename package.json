    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@tailwindcss/vite": "4.3.3",
    "postcss": "8.5.28",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "2.7.5",
    "@analogjs/vite-plugin-angular": "2.7.5",
