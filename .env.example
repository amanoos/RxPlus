# RxPlus configuration.
# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds secrets: it is gitignored. Never commit it, paste it into chats, or share it.
# The server checks everything at startup and names any variable that is missing or invalid.
#
# Required: the four values in "1. Sign-in and security" and "2. Database".
# Everything else has a working default or is optional. Only three services need an
# account, and all are optional: openFDA and NCBI (free keys that raise rate limits)
# and Anthropic (Claude, paid). RxNorm, MedlinePlus, ClinicalTrials.gov, Cost Plus
# Drugs and DDInter need no account.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Sign-in and security (required)
# ─────────────────────────────────────────────────────────────────────────────

# Your login password, stored only as a hash. Generate it (asks for the password twice,
# at least 12 characters). It prints a line "APP_PASSWORD_HASH=scrypt:..."; replace the
# line below with it:
#   npm run hash-password
#   (without Node.js: docker run --rm -it -v "${PWD}:/app" -w /app node:24-bookworm-slim node scripts/hash-password.ts)
APP_PASSWORD_HASH=

# Signs the session cookie. At least 32 random characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   (without Node.js: openssl rand -base64 32)
# Changing it signs everyone out.
SESSION_SECRET=

# "true" only when the app is served over HTTPS. On a home LAN over plain HTTP: false.
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# 2. Database (PostgreSQL, runs in Docker)
# ─────────────────────────────────────────────────────────────────────────────

# Password for the database container. Choose any strong password, letters and digits
# only (it goes inside a connection URL). It is fixed when the database volume is first
# created: changing it later here does not change the database's password.
POSTGRES_PASSWORD=

# Connection used by `npm run dev`, migrations and scripts on your PC (local development).
# Put the same password as POSTGRES_PASSWORD and the port from DB_DEV_PORT.
# Docker Compose ignores this and connects to its `db` service itself.
DATABASE_URL=postgres://rxplus:your-postgres-password@localhost:5432/rxplus

# Host port for the development database (npm run db:up). Change it if 5432 is taken.
DB_DEV_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# 3. Server
# ─────────────────────────────────────────────────────────────────────────────

# Port the server listens on inside its container or process.
PORT=3000
# Port on your computer where Docker publishes the app: http://<computer-ip>:APP_PORT
APP_PORT=3000
# Time zone for the weekly digest (Monday 6:00 AM) and the nightly backup. IANA name.
TZ=America/New_York

# ─────────────────────────────────────────────────────────────────────────────
# 4. User interface license (PrimeNG)
# ─────────────────────────────────────────────────────────────────────────────

# PrimeUI Community License key, free for individuals.
#   How to get it: go to https://primeui.dev/licenses/community, sign up with your email,
#   and copy the license key from your PrimeUI account.
# Build-time: baked into the page bundle (not a secret). Changing it needs a rebuild
# (docker compose up -d --build). Without it the app still works; PrimeNG logs a
# "license is not configured" warning in the browser console.
VITE_PRIMEUI_LICENSE=

# ─────────────────────────────────────────────────────────────────────────────
# 5. Drug data sources that need no account (defaults are the public services)
# ─────────────────────────────────────────────────────────────────────────────
# Change these only to point at a mirror or test stub (the e2e tests do).

# RxNorm via NLM's RxNav: drug names, strengths, products, classes, uses. No key.
# RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
# MedlinePlus Connect: patient-friendly drug information links. No key.
# MEDLINEPLUS_BASE_URL=https://connect.medlineplus.gov/service
# ClinicalTrials.gov API v2: trials on drug pages and in the digest. No key.
# CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
# Mark Cuban Cost Plus Drug Company public price API: cash prices. No key.
# COSTPLUS_BASE_URL=https://us-central1-costplusdrugs-publicapi.cloudfunctions.net/main
# (DDInter interaction data is downloaded by `npm run ddi:import`; nothing to configure.)

# ─────────────────────────────────────────────────────────────────────────────
# 6. openFDA: FDA drug labels, reported side effects, approvals (optional free key)
# ─────────────────────────────────────────────────────────────────────────────

# Works without a key (1,000 requests a day per IP address). A key raises that to
# 120,000 a day, which helps when building alternatives lists or on a shared network.
#   How to get it: go to https://open.fda.gov/apis/authentication/, click
#   "Get your API key", enter your email, and copy the key shown (it is also emailed).
#   No account or payment. Sent only to api.fda.gov, never logged.
# OPENFDA_API_KEY=your-openfda-api-key
# OPENFDA_BASE_URL=https://api.fda.gov/drug

# ─────────────────────────────────────────────────────────────────────────────
# 7. NCBI PubMed: research papers (optional free key)
# ─────────────────────────────────────────────────────────────────────────────

# Works without a key (3 requests a second). A key raises it to 10, making research
# lists and digests faster.
#   How to get it: create a free NCBI account at https://account.ncbi.nlm.nih.gov/
#   (or sign in with Google, ORCID or login.gov), open Account settings
#   (https://account.ncbi.nlm.nih.gov/settings/), find "API Key Management" and click
#   "Create an API Key". Copy the key. Sent only to NCBI, never logged.
# NCBI_API_KEY=your-ncbi-api-key
# Your contact email. NCBI asks programs to send one so they can reach you about
# problems before blocking. Optional.
# NCBI_EMAIL=you@example.com
# PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# ─────────────────────────────────────────────────────────────────────────────
# 8. AI: drug label summaries and research takeaways
# ─────────────────────────────────────────────────────────────────────────────
# Two providers:
#   ollama: a free local model on your own computer (default). Needs a GPU for speed.
#   claude: Anthropic's Claude API. Paid per use; most accurate takeaways.
# Only public label text and paper abstracts are ever sent to a model, never your
# medication list or notes. Without any AI configured, the rest of the app works.

# Provider for drug label summaries: ollama or claude.
SUMMARY_PROVIDER=ollama
# Provider for research and digest takeaways only: ollama or claude.
# Default: the same as SUMMARY_PROVIDER. Claude is recommended for takeaways (in a
# 29-paper comparison it linked all 29 to their source sentence with no meaning errors).
# TAKEAWAY_PROVIDER=claude

# --- Ollama (local models) ---
#   How to set it up: install Ollama from https://ollama.com/download (Windows, macOS,
#   Linux; no account needed), then download the models:
#     ollama pull qwen2.5:7b     (~4.7 GB, summaries)
#     ollama pull qwen3:8b       (~5.2 GB, optional, better local takeaways)
#   An 8 GB GPU runs either. On a Linux server, let Docker reach Ollama (see README).
# Where Ollama listens. For `npm run dev` on your PC use 127.0.0.1 (not "localhost").
# Docker Compose overrides it with http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model for summaries (and for takeaways unless set below). Leave empty to turn local AI off.
OLLAMA_MODEL=qwen2.5:7b
# Optional: a different local model for takeaways.
# OLLAMA_TAKEAWAY_MODEL=qwen3:8b
# Optional: a stronger local model that double-checks each takeaway against its quote.
# Off when unset (small models judged too unreliably to be useful).
# OLLAMA_CHECK_MODEL=qwen2.5:14b
# Context window in tokens; long FDA labels need a large one.
# OLLAMA_NUM_CTX=16384
# Time limit per model call, in milliseconds (10 minutes).
# OLLAMA_TIMEOUT_MS=600000

# --- Claude (Anthropic API, paid) ---
#   How to get a key:
#     1. Create an account at https://console.anthropic.com/ (email or Google).
#     2. Add a payment method and buy credits under Settings > Billing (prepaid; there
#        is no free tier for the API). Optionally set a monthly spend limit there.
#     3. Go to Settings > API keys, click "Create Key", name it (e.g. rxplus), and copy
#        it right away: it is shown only once. It starts with "sk-ant-".
#   Typical cost: under $1 a week for weekly digest takeaways with ~5 medications, and
#   about $0.10-0.20 per label summary. Never logged; sent only to api.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-your-key
# Most Claude requests per day (summaries and takeaways together); a hard cap on cost.
# A weekly digest uses about 7. Does not apply to Ollama.
# AI_DAILY_LIMIT=20

# --- Jev (TypeSafe decision model, optional) ---
#   Two checks, made when takeaways are written:
#   - Double-checks each local (Ollama) takeaway against its quote with one yes/no per
#     paper, answered with a confidence; unsure answers are left unmarked. Replaces
#     OLLAMA_CHECK_MODEL when both are set. Claude takeaways are not checked (their
#     citations already tie them to the abstract).
#   - Labels who was studied (review, animals, lab, people) for papers whose words
#     alone don't say, with either takeaway model.
#   Key: from TypeSafe (https://typesafe.ai), or a Vercel AI Gateway key with
#   JEV_PROVIDER=gateway. Sent: each takeaway and its quote, and the title and public
#   abstract of papers to label, to api.typesafe.ai (or the Gateway). Never logged.
# JEV_API_KEY=your-key
# typesafe (default) or gateway.
# JEV_PROVIDER=typesafe
# Optional: a different address for the service.
# JEV_BASE_URL=https://api.typesafe.ai
# Time limit per check, in milliseconds (30 seconds).
# JEV_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# 9. Backups (the Docker Compose `backup` service)
# ─────────────────────────────────────────────────────────────────────────────

# Folder for the nightly database dumps. Holds personal data: keep it private.
# Point it at another disk or a synced folder for protection against disk failure,
# e.g. BACKUP_DIR=D:/RxPlus-backups
# BACKUP_DIR=./backups
# How many dumps to keep (one a night, so 30 = a month).
# BACKUP_KEEP=30
# Hour of the nightly dump, 0-23, in TZ.
# BACKUP_HOUR=3
