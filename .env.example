# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection. In Docker Compose the host is `db`; for local dev use localhost.
DATABASE_URL=postgres://rxplus:change-me@localhost:5432/rxplus

# Single-user login. Generate with: npm run hash-password
APP_PASSWORD_HASH=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# "true" only when served over HTTPS. LAN over plain HTTP: false.
COOKIE_SECURE=false

PORT=3000
TZ=America/New_York

# PrimeUI Community License key (free for individuals): https://primeui.dev/licenses/community
# Build-time: inlined into the client bundle, so it is not a secret.
VITE_PRIMEUI_LICENSE=
