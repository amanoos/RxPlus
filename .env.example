# Copy to .env and fill in. Never commit .env.

# PostgreSQL password used by the db container (Docker Compose reads it from .env).
POSTGRES_PASSWORD=change-me
# Host port for the dev database (npm run db:up). Change if 5432 is taken.
DB_DEV_PORT=5432

# PostgreSQL connection. In Docker Compose the host is `db`; for local dev use
# localhost and DB_DEV_PORT.
DATABASE_URL=postgres://rxplus:change-me@localhost:5432/rxplus

# Single-user login. Generate with: npm run hash-password
APP_PASSWORD_HASH=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# "true" only when served over HTTPS. LAN over plain HTTP: false.
COOKIE_SECURE=false

PORT=3000
# Host port for the app when run with Docker Compose.
APP_PORT=3000
TZ=America/New_York

# PrimeUI Community License key (free for individuals): https://primeui.dev/licenses/community
# Build-time: inlined into the client bundle, so it is not a secret.
VITE_PRIMEUI_LICENSE=

# Optional: RxNorm API base URL (defaults to NLM's public RxNav).
# RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# Optional: openFDA (drug labels). A free key raises the daily request limit.
# OPENFDA_BASE_URL=https://api.fda.gov/drug
# MEDLINEPLUS_BASE_URL=https://connect.medlineplus.gov/service
# Research (PubMed, ClinicalTrials.gov). An NCBI key is optional (raises the limit from 3 to 10 requests/s).
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com
# PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
# Cost Plus Drugs public price API (pricing); the e2e tests point it at a local stub.
# COSTPLUS_BASE_URL=https://us-central1-costplusdrugs-publicapi.cloudfunctions.net/main
# OPENFDA_API_KEY=

# AI drug summaries: a local model via Ollama (default) or Claude.
SUMMARY_PROVIDER=ollama
# Dev: 127.0.0.1 (not localhost). In Docker, Compose sets http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional: a stronger model that checks each research takeaway against its quote (off when unset).
# OLLAMA_CHECK_MODEL=qwen2.5:14b
# OLLAMA_NUM_CTX=16384
# OLLAMA_TIMEOUT_MS=600000
# Optional Claude (SUMMARY_PROVIDER=claude); capped per day.
# ANTHROPIC_API_KEY=
# AI_DAILY_LIMIT=20

# Backups (the Docker Compose backup service): folder, how many to keep, hour of the nightly dump.
# BACKUP_DIR=./backups
# BACKUP_KEEP=30
# BACKUP_HOUR=3
